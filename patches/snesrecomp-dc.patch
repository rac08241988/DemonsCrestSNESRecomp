+/* Runtime preset switch (a game's in-game options menu). NULL/"" = off.
+ * The old chain is kept when the new preset fails to compile. The choice is
+ * also recorded as the configured shader so a Reconfigure (after the in-game
+ * launcher) keeps it instead of reverting to the startup value. */
+static bool g_gl_ready;
+static unsigned g_gl_present_count;
+bool OpenGLRenderer_SetShader(const char *path) {
+  if (!g_gl_ready) return false;
+  GlslShader *ns = NULL;
+  if (path && path[0]) {
+    ns = GlslShader_CreateFromFile(path);
+    if (!ns) return false;
+  }
+  if (g_glsl_shader) GlslShader_Destroy(g_glsl_shader);
+  g_glsl_shader = ns;
+  snprintf(g_shader_path, sizeof(g_shader_path), "%s", path ? path : "");
+  g_shader_resolved = true;
+  {
+    static char *owned;
+    free(owned);
+    owned = (path && path[0]) ? strdup(path) : NULL;
+    g_config.shader = owned;
+  }
+  return true;
+}
+
+bool OpenGLRenderer_IsActive(void) { return g_gl_ready; }
+
+/* Test hook: SNESRECOMP_GL_SHOT=<file.ppm> SNESRECOMP_GL_SHOT_FRAME=<n>
+ * [SNESRECOMP_GL_SHOT_COUNT=<k>] writes the final (post-shader) back buffer
+ * of the n-th presented frame (k frames, numbered, with COUNT). */
+static void MaybeGlShot(int w, int h) {
+  const char *path = getenv("SNESRECOMP_GL_SHOT");
+  const char *fr = getenv("SNESRECOMP_GL_SHOT_FRAME");
+  const char *cnt = getenv("SNESRECOMP_GL_SHOT_COUNT");
+  if (!path || !fr) return;
+  unsigned first = (unsigned)atoi(fr), n = cnt ? (unsigned)atoi(cnt) : 1;
+  if (g_gl_present_count < first || g_gl_present_count >= first + n) return;
+  char numbered[1100];
+  if (cnt) {
+    snprintf(numbered, sizeof(numbered), "%s.%05u.ppm", path, g_gl_present_count);
+    path = numbered;
+  }
+  unsigned char *px = (unsigned char *)malloc((size_t)w * h * 3);
+  if (!px) return;
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+  glReadPixels(0, 0, w, h, GL_RGB, GL_UNSIGNED_BYTE, px);
+  FILE *f = fopen(path, "wb");
+  if (f) {
+    fprintf(f, "P6\n%d %d\n255\n", w, h);
+    for (int y = h - 1; y >= 0; y--) fwrite(px + (size_t)y * w * 3, 1, (size_t)w * 3, f);
+    fclose(f);
+  }
+  free(px);
+}
