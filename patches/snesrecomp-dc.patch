+  snprintf(g_relaunch.rom, sizeof(g_relaunch.rom), "%s", g_rom_path);
+  g_relaunch.launcher = false;
+  g_relaunch.with_state =
+      snesrecomp_abspath("saves/resume.sav", g_relaunch.state, sizeof(g_relaunch.state)) &&
+      RtlSaveSnapshot(g_relaunch.state);
+  g_relaunch.pending = true;
+  *running = false;
+  *exit_reason = "renderer switch requested by the game's menu";
+  host_report_breadcrumb("renderer switch to '%s': restarting%s", id,
+                         g_relaunch.with_state ? " from this moment" : "");
