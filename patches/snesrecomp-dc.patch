@@ -101,4 +101,32 @@ void snes_ovl_draw_button(uint32_t *dst, int stride, int h_max,
 #define SNES_OVL_COL_X  0xFF5FA8FFu
 #define SNES_OVL_COL_Y  0xFFFFD24Du
 
+/* Controller-aware prompts. The overlays act on three meanings -- confirm
+ * (load / select / commit), back, and the alternate action (save) -- and the
+ * host routes the PHYSICAL pad buttons onto them by the player's controller
+ * family (desktop host_main.c, OverlayPadNav):
+ *
+ *   family       confirm        back           alternate
+ *   Xbox/other   South (A)      East (B)       West (X)
+ *   PlayStation  South (Cross)  East (Circle)  West (Square)
+ *   Nintendo     East (A)       South (B)      North (X)
+ *
+ * so a prompt is drawn from the same table and always names the button that
+ * does it. The host sets the family of the pad last used (default Xbox). */
+enum {
+    SNES_OVL_PAD_XBOX = 0,
+    SNES_OVL_PAD_PLAYSTATION = 1,
+    SNES_OVL_PAD_NINTENDO = 2
+};
+enum {
+    SNES_OVL_ACT_CONFIRM = 0,
+    SNES_OVL_ACT_BACK = 1,
+    SNES_OVL_ACT_ALT = 2
+};
+void snes_ovl_set_pad_style(int style);
+int snes_ovl_pad_style(void);
+/* The 18x18 glyph for `action` in the current family's look. */
+void snes_ovl_draw_action(uint32_t *dst, int stride, int h_max,
+                          int x, int y, int action);
+
 #endif /* SNES_OVERLAY_DRAW_H */
