+  switch (button) {
+  case kGamepadBtn_A: return nin ? SNES_PAD_B : SNES_PAD_A;   /* south */
+  case kGamepadBtn_B: return nin ? SNES_PAD_A : SNES_PAD_B;   /* east */
+  case kGamepadBtn_X: return nin ? 0 : SNES_PAD_X;            /* west */
+  case kGamepadBtn_Y: return nin ? SNES_PAD_X : 0;            /* north */
+  case kGamepadBtn_Back: return SNES_PAD_SELECT;
+  case kGamepadBtn_Start: return SNES_PAD_START;
+  case kGamepadBtn_R1: return SNES_PAD_R;
+  case kGamepadBtn_L1: return SNES_PAD_L;
+  case kGamepadBtn_DpadUp: return SNES_PAD_UP;
+  case kGamepadBtn_DpadDown: return SNES_PAD_DOWN;
+  case kGamepadBtn_DpadLeft: return SNES_PAD_LEFT;
+  case kGamepadBtn_DpadRight: return SNES_PAD_RIGHT;
+  default: return 0;
+  }
