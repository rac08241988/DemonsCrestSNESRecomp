+            snes_ovl_fill_rect(dst, stride, h_max, x + 12 - i, y + 5 + i, 2, 1, col);
+        }
+        break;
+    case 1: /* circle */
+        snes_ovl_fill_disc(dst, stride, h_max, x + 9, y + 9, 5, col);
+        snes_ovl_fill_disc(dst, stride, h_max, x + 9, y + 9, 3, 0xFF171B25u);
+        break;
+    default: /* square */
+        snes_ovl_stroke_rect(dst, stride, h_max, x + 5, y + 5, 9, 9, col);
+        snes_ovl_stroke_rect(dst, stride, h_max, x + 6, y + 6, 7, 7, col);
