+  for (int b = 0; b < kGamepadBtn_Count; b++)
+    if (gi->modifiers & (1u << b)) bits |= OverlayPadBit(style, b);
+  g_overlay_pad_nav = bits;
+  snes_ovl_set_pad_style(style);
+}
