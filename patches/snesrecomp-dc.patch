+  if (n > ov_cap) {
+    free(ov_black);
+    free(ov_white);
+    ov_black = (uint32_t *)malloc(n * 4);
+    ov_white = (uint32_t *)malloc(n * 4);
+    ov_cap = (ov_black && ov_white) ? n : 0;
